[Unit]
Description=Trend Bot — meme/news trend detector
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/trend-bot
ExecStart=/root/trend-bot/venv/bin/python main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
