# ── Telegram ──────────────────────────────────────────────────────────────────
# Get token from @BotFather on Telegram → /newbot
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Your group/channel ID (negative number for groups/channels)
# Get it via: https://api.telegram.org/bot<TOKEN>/getUpdates after adding the bot
TELEGRAM_CHAT_ID=-1001234567890

# ── Twitter / X ───────────────────────────────────────────────────────────────
# Get these from your browser: F12 → Application → Cookies → twitter.com
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
TWITTER_TWID=
TWITTER_KDT=
# WOEID for trending location: 1=Worldwide, 23424977=United States
TWITTER_WOEID=1

# ── Google Trends ─────────────────────────────────────────────────────────────
GOOGLE_TRENDS_GEO=US
GOOGLE_TRENDS_LANGUAGE=en-US

# ── Scoring & Alert Thresholds ────────────────────────────────────────────────
# Composite score (0.0–1.0) required to fire an alert
ALERT_THRESHOLD=0.45
# Hours before the same trend can be re-alerted
RE_ALERT_COOLDOWN_HOURS=2
# Minimum score increase since last alert to allow re-alert
SCORE_INCREASE_THRESHOLD=0.10

# ── Scheduling ────────────────────────────────────────────────────────────────
SCRAPE_INTERVAL_MINUTES=10

# ── Storage ───────────────────────────────────────────────────────────────────
DATABASE_PATH=data/trends.db

# ── 4chan Filters ─────────────────────────────────────────────────────────────
# Minimum reply count for a thread to be considered
FOURCHAN_MIN_REPLIES=20
